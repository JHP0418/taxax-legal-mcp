# 운영자가 관리하며 일반 직원에게 발급을 요구하지 않습니다.
TAXAX_LAW_GO_OC=
# 비워 두면 OS 표준 사용자 data directory를 사용합니다.
TAXAX_LEGAL_DATA_DIR=
TAXAX_NTS_ENABLED=0
TAXAX_NTS_TERMS_CONFIRMED=0
TAXAX_OLTA_ENABLED=0
TAXAX_OLTA_TERMS_CONFIRMED=0
TAXAX_KOREAN_LAW_BRIDGE=disabled

# 선택 사설 자료는 공개 package에서 자동 탐색하지 않습니다.
TAXAX_PRIVATE_KNOWLEDGE_DIR=
TAXAX_LEGACY_SNAPSHOT_ROOT=
TAXAX_PROJECT_ROOT=.

# 인증 없는 HTTP는 loopback에서만 명시적으로 허용할 수 있습니다.
TAXAX_MCP_ALLOW_LOCAL_HTTP=0

# Hosted HTTP는 아래 4개와 Host/Origin allowlist가 모두 필요합니다.
TAXAX_MCP_AUTH_ISSUER=https://issuer.example.invalid
TAXAX_MCP_AUTH_AUDIENCE=taxax-legal
TAXAX_MCP_AUTH_RESOURCE=https://legal.example.invalid
TAXAX_MCP_AUTH_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
TAXAX_MCP_AUTH_REQUIRED_SCOPES=legal.read
TAXAX_MCP_AUTH_ALGORITHMS=RS256
TAXAX_MCP_AUTH_ORG_CLAIM=org_id
TAXAX_MCP_ALLOWED_HOSTS=legal.example.invalid
TAXAX_MCP_ALLOWED_ORIGINS=https://client.example.invalid
